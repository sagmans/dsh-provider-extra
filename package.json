{
  "name": "@sagmans/dsh-provider-extra",
  "version": "0.8.1",
  "description": "Extra LLM provider routes for DeepSeek Harness: OpenCode Go with per-session x-opencode-session routing, and OpenAI Codex over ChatGPT-subscription OAuth.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "llm",
    "provider",
    "opencode",
    "codex",
    "cordis"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./headless-startup": "./dist/headless-startup.js",
    "./headless.patch.yml": "./headless.patch.yml",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-provider-extra-login": "./dist/login-cli.js"
  },
  "files": [
    "dist",
    "docs",
    "cordis.patch.yml",
    "headless.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagmans/dsh-provider-extra.git"
  },
  "homepage": "https://github.com/sagmans/dsh-provider-extra#readme",
  "bugs": "https://github.com/sagmans/dsh-provider-extra/issues",
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "catalog:setup": "node tools/catalog-setup.mjs",
    "codex:login": "node --import tsx/esm src/login-cli.ts",
    "test": "node --import tsx/esm --test \"tests/*.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node tools/build-client.mjs",
    "build:client": "node tools/build-client.mjs",
    "test:build": "node --test \"tests/*.test.mjs\"",
    "test:release": "python3 -m unittest discover -s tests/release -p 'test_*.py'",
    "pack-smoke": "node tools/pack-smoke.mjs",
    "matrix": "node tools/harness-matrix.mjs",
    "check": "pnpm run typecheck && pnpm test && node tools/harness-matrix.mjs && pnpm run build && pnpm run test:build && pnpm run test:release && pnpm run pack-smoke",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run test:release"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.1.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials-local": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5 <3.19.0-0",
    "@earendil-works/pi-ai": ">=1.1.0 <1.5.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
